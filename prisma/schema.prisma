generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  INBOX
  NEXT
  DOING
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  FEATURE
  BUG
  CHORE
  RESEARCH
}

model Task {
  id             String       @id @default(cuid())
  title          String
  type           TaskType     @default(CHORE)
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(INBOX)
  owner          String?
  deadline       DateTime?
  context        String?
  expectedOutput String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Agent {
  id         String   @id @default(cuid())
  name       String
  mission    String
  status     String
  blocker    String?
  nextStep   String?
  lastUpdate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
